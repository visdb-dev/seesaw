<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.visdb.seesaw</groupId>
    <artifactId>seesaw-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>seesaw</artifactId>
  <packaging>jar</packaging>

  <name>${group_abbrev}:${project.artifactId}</name>

  <properties>
    <property-file.seesawVersion>seesawVersion.properties</property-file.seesawVersion>
  </properties>

  <dependencies>
    <dependency>
      <!-- 
        Fixes a latent 'not found' bytecode reference flagged by jdeps.
        This library is omitted from the transitive metadata of certain upstream 
        dependencies (like Guava), but its annotations remain in the bytecode.
        This allows jdeps to run cleanly.
      -->
      <groupId>com.google.j2objc</groupId>
      <artifactId>j2objc-annotations</artifactId>
      <version>3.1</version>
    </dependency>
    <dependency>
      <groupId>com.raelity.3rdparty.com.glazedlists</groupId>
      <artifactId>glazedlists</artifactId>
    </dependency>
    <!-- With this, need to use exclusion below for weak-bus-receiver -->
    <dependency>
      <groupId>com.raelity.3rdparty.org.netbeans</groupId>
      <artifactId>util-lookup</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
    </dependency>
    <dependency>
      <groupId>com.raelity.jdk</groupId>
      <artifactId>table-sort-header-renderer</artifactId>
    </dependency>
    <dependency>
      <groupId>com.raelity.lib</groupId>
      <artifactId>weak-event-bus-receiver</artifactId>
      <!-- only need the exclusion if using raelity/util-lookup -->
      <exclusions>
        <exclusion>
          <groupId>org.netbeans.api</groupId>
          <artifactId>org-openide-util-lookup</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-properties</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
        <!-- 1. Only filter specific files -->
        <resource>
            <directory>src/main/resources</directory>
            <filtering>true</filtering>
            <includes>
                <include>${property-file.seesawVersion}</include>
                <!-- You can also use wildcards, like **/*.properties -->
            </includes>
        </resource>
        
        <!-- 2. Copy everything else WITHOUT filtering -->
        <resource>
            <directory>src/main/resources</directory>
            <filtering>false</filtering>
            <excludes>
                <exclude>${property-file.seesawVersion}</exclude>
            </excludes>
        </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>

      <!-- include following for display-variable-value -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
