// open the module to everything...
/*open*/ module dev.visdb.seesaw {

    // 1. EXPORTS: Expose your API packages to consumers
    exports dev.visdb.seesaw.utils;
    exports dev.visdb.seesaw.decorators;
    exports dev.visdb.seesaw.core;
    exports dev.visdb.seesaw.core.table;
    exports dev.visdb.seesaw.models;
    exports dev.visdb.seesaw.navigate;
    exports dev.visdb.seesaw.formatting;
    exports dev.visdb.seesaw.datasources;
    exports dev.visdb.seesaw.datasources.products;
    exports dev.visdb.seesaw.enums;

    requires java.base;
    requires java.datatransfer;
    requires java.desktop;
    requires java.sql;
    requires java.sql.rowset;

    // AUTOMATIC MODULE NAMES FOR NETBEANS
    // requires org.openide.util.RELEASE310;
    // requires org.openide.util.lookup.RELEASE310;
    requires util.lookup.bundle;

    // MODERN EXPLICIT MODULES
    requires tools.jackson.core;
    requires tools.jackson.databind;
    requires tools.jackson.dataformat.properties;

    // AUTOMATIC MODULES 
    requires com.google.common; // Guava
    
    // RAELITY / FILENAME-BASED AUTOMATIC MODULES
    // Note: If compilation fails on these three, run 'mvn dependency:tree' 
    // to verify the final clean JAR name Maven assigns to them.
    requires glazedlists; 
    requires table.sort.header.renderer;
    requires weak.event.bus.receiver;

    //
    // Since seesaw only uses java classes for databinding don't need this.
    //
    // // REFLECTION BLUEPRINT FOR JACKSON (Crucial for a library)
    // // Jackson needs to look inside your DTO/Model classes to parse data.
    // // Instead of using an "open module", selectively open your model package.
    // opens com.yourcompany.yourlibraryname.models to tools.jackson.databind;

    // opens dev.visdb.seesaw.utils to weak.event.bus.receiver;
}

